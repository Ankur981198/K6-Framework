{
  "name": "local",
  "baseUrl": "https://rahulshettyacademy.com",

  "http": {
    "timeout": "30s",
    "retries": 1,
    "retryDelaySeconds": 1
  },

  "auth": {
    "enabled": true,
    "tokenUrl": "/api/ecom/auth/login",
    "method": "POST",

    "headers": {
      "Content-Type": "application/json"
    },

    "credentials": {
      "userEmail": "${USER_EMAIL}",
      "userPassword": "${USER_PASSWORD}"
    },

    "expectedStatuses": [200],
    "tokenPath": "token",
    "headerName": "Authorization",
    "headerPrefix": "" 
  },

  "pacing": {
    "thinkTimeSeconds": 1
  }
}